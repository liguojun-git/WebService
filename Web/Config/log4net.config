<?xml version="1.0" encoding="utf-8"?>
<log4net>
	<!-- ログ出力定義_DB? -->
	<!-- ログ出力定義_Console -->
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
		</layout>
	</appender>
	<!-- ログ出力定義_稼働時全量 -->
	<appender name="ALLAppender" type="log4net.Appender.RollingFileAppender">
		<!-- ログ・ファイル名の先頭部分 -->
		<file value="D:\log\MKWebAPI" />
		<!-- 追加書き込み -->
		<appendToFile value="true" />
		<!-- 日付・ファイルサイズごとに作成することを指定 -->
		<rollingStyle value="Composite"/>
		<!-- ログ・ファイル名が固定ではないため“false”を指定 -->
		<staticLogFileName value="false"/>
		<!-- ローリングするファイルサイズを指定 -->
		<maximumFileSize value="102400KB"/>
		<!-- バックアップファイル数を無制限にする -->
		<maxSizeRollBackups value="-1"/>
		<!-- 番号なしのファイルに書き込むようにする -->
		<countDirection value="-1"/>
		<!-- ファイル名の日付部分 -->
		<datePattern value='yyyyMMdd".log"'/>
		<!-- ファイルの文字エンコーディング -->
		<encoding value="UTF-8"/>
		<!-- ログ出力レイアウト -->
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%d [%5t] %5p (%C:%M:%L) - %m%n"/>
		</layout>
		<Threshold value="ALL"/>
		<!-- 出力対象となるログレベルの範囲：INFO以上 -->
		<Filter type="log4net.Filter.LevelRangeFilter">
			<levelMin value="INFO"/>
			<levelMax value="FATAL"/>
		</Filter>
	</appender>
	<!-- ログ出力定義_監視用エラー -->
	<appender name="ErrorAppender" type="log4net.Appender.RollingFileAppender">
		<!-- ログ・ファイル名の先頭部分 -->
		<file value="D:\log\MKWebAPIError_" />
		<!-- 追加書き込み -->
		<appendToFile value="true" />
		<!-- 日付・ファイルサイズごとに作成することを指定 -->
		<rollingStyle value="Composite"/>
		<!-- ログ・ファイル名が固定ではないため“false”を指定 -->
		<staticLogFileName value="false"/>
		<!-- ローリングするファイルサイズを指定 -->
		<maximumFileSize value="102400KB"/>
		<!-- バックアップファイル数を無制限にする -->
		<maxSizeRollBackups value="-1"/>
		<!-- 番号なしのファイルに書き込むようにする -->
		<countDirection value="-1"/>
		<!-- ファイル名の日付部分 -->
		<datePattern value='yyyyMMdd".log"'/>
		<!-- ファイルの文字エンコーディング -->
		<encoding value="UTF-8"/>
		<!-- ログ出力レイアウト -->
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%d [%5t] %5p (%C:%M:%L) - %m%n"/>
		</layout>
		<Threshold value="ERROR"/>
		<!-- 出力対象となるログレベルの範囲：INFO以上 -->
		<Filter type="log4net.Filter.LevelRangeFilter">
			<levelMin value="ERROR"/>
			<levelMax value="FATAL"/>
		</Filter>
	</appender>
	<!-- root -->
	<root>
		<level value="ALL" />
		<appender-ref ref="ALLAppender" />
		<appender-ref ref="ErrorAppender" />
	</root>
</log4net>